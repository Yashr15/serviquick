# ── Backend environment variables ─────────────────────────────────────────────
# Copy this file to .env and fill in the real values.
# Never commit the .env file – it is in .gitignore.

PORT=4000

# MongoDB connection URI.
# When running with docker-compose, use the mongo service name:
#   mongodb://admin:changeme@mongo:27017/serviquick?authSource=admin
# For MongoDB Atlas:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/serviquick?retryWrites=true&w=majority
MONGODB_URI=mongodb://admin:changeme@mongo:27017/serviquick?authSource=admin

# MongoDB container credentials (docker-compose only)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme

# JWT signing secret – use a long random string in production
JWT_SECRET=supersecretchangeme

NODE_ENV=development

# Comma-separated list of allowed CORS origins.
# In production, set this to your frontend's public URL (ALB DNS or custom domain).
# Example: https://app.serviquick.io,https://www.serviquick.io
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Comma-separated list of allowed CORS origins (optional).
# If not set, defaults to localhost:5173, localhost:5174 and the Vercel deployment.
# Example for multiple origins:
#   CORS_ORIGIN=https://myapp.vercel.app,https://api.myapp.com
# CORS_ORIGIN=
